# Path to Google OAuth Desktop client JSON (Analytics Data API)
GA4_CREDENTIALS_PATH=./credentials/credentials.json

# Where the refresh/access token is stored after first login
GA4_TOKEN_PATH=./credentials/token.json

# GA4 property ID (numeric only, no "properties/" prefix)
# Find in GA4 Admin → Property Settings → Property ID
GA4_PROPERTY_ID=000000000

# Optional: human label for reports
GA4_PROPERTY_LABEL=locumcareerhub.com

# Key events / conversions to emphasize (comma-separated GA4 event names)
# Site currently fires generate_lead, booking_link_click, viral_share, etc.
GA4_CONVERSION_EVENTS=generate_lead,booking_link_click,viral_share,locums_calculator_lead_success,decision_tool_lead_success

# Optional default hostname for landing page matching
GA4_DEFAULT_HOST=www.locumcareerhub.com
