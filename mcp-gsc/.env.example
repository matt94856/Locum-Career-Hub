# Path to Google OAuth Desktop client JSON downloaded from Google Cloud
# (also accepted at ./credentials/credentials.json)
GSC_CREDENTIALS_PATH=./credentials/credentials.json

# Where the refresh/access token is stored after first login
GSC_TOKEN_PATH=./credentials/token.json

# Default Search Console property URL (must match GSC exactly)
# Examples: https://www.locumcareerhub.com/  OR  sc-domain:locumcareerhub.com
GSC_DEFAULT_SITE_URL=https://www.locumcareerhub.com/
